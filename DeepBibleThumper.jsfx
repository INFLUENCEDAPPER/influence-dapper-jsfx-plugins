desc: INFLUENCE DAPPER DEEP BIBLE THUMPER
author: INFLUENCEDAPPER.COM
tags: INFLUENCE DAPPER BIBLE THUMPER THUMP RUMP COM 2026

slider1:thump_on=1<0,1,1{OFF,ON}>THUMP
slider2:rump_on=1<0,1,1{OFF,ON}>RUMP
slider3:more=50<0,100,1>MORE

@init
ceiling   = 10^(-0.3/20);
sr        = srate;
twopi     = 2*$pi;
noise_st  = 54321;
lim_env   = 1;
click_held = 0;

// Built-in band-limit: 90 Hz HP (12 dB/oct) and 10 kHz LP (12 dB/oct).
hp_a = exp(-twopi * 90    / sr);
lp_a = 1 - exp(-twopi * 10000 / sr);

@block
while (midirecv(offset, msg1, msg2, msg3)) (
  status = msg1 & 0xF0;
  note   = msg2;
  vel    = msg3;
  (status == 0x90 && vel > 0) ? (
    pc = note % 12;
    is_black = (pc==1)||(pc==3)||(pc==6)||(pc==8)||(pc==10);
    is_black ? (
      rump_on ? (
        rump_active = 1;
        rump_env    = 1;
        rump_phase  = 0;
        rump_pitch  = 220;
        rump_click  = 1;
      );
    ) : (
      thump_on ? (
        thump_active    = 1;
        thump_phase     = 0;
        thump_env       = 1;
        thump_pitch     = 240;
        thump_click_env = 1;
      );
    );
  );
  midisend(offset, msg1, msg2, msg3);
);

@sample
out = 0;

// THUMP - basketball-on-wood, dropped an octave below intuition.
// Pitch sweeps fast from 240 Hz down to the 90 Hz bandwidth floor.
// Pure sine body with a tiny noise transient for wood contact.
thump_active ? (
  thump_pitch = max(90, thump_pitch * exp(-1/(0.035*sr)));
  thump_phase += twopi * thump_pitch / sr;
  thump_phase >= twopi ? thump_phase -= twopi;
  body  = sin(thump_phase) * thump_env;
  noise_st = (noise_st * 1103515245 + 12345) & 0x7FFFFFFF;
  nT = (noise_st / 1073741824) - 1;
  click = thump_click_env > 0.01 ? (nT * 0.18 * thump_click_env) : 0;
  thump_click_env *= exp(-1/(0.0025*sr));
  out += (body * 0.95 + click) * ceiling;
  thump_env *= exp(-1/(0.22*sr));
  thump_env < 0.001 ? thump_active = 0;
);

// RUMP - palm-on-pork slap, dropped an octave below intuition.
// Short filtered-noise burst over a 220 -> 110 Hz body resonance.
// Squared envelope on the noise gives a sharp slap transient.
rump_active ? (
  noise_st = (noise_st * 1103515245 + 12345) & 0x7FFFFFFF;
  nR = (noise_st / 1073741824) - 1;
  rump_pitch = max(110, rump_pitch * exp(-1/(0.02*sr)));
  rump_phase += twopi * rump_pitch / sr;
  rump_phase >= twopi ? rump_phase -= twopi;
  body  = sin(rump_phase) * rump_env * 0.55;
  slap  = nR * rump_env * rump_env * 0.55;
  out  += (body + slap) * ceiling;
  rump_env *= exp(-1/(0.07*sr));
  rump_env < 0.001 ? rump_active = 0;
);

// 90 Hz - 10 kHz band-limit, cascaded one-poles for 12 dB/oct each side.
hp_y1 = hp_a * (hp_y1 + out  - hp_x1); hp_x1 = out;
hp_y2 = hp_a * (hp_y2 + hp_y1 - hp_x2); hp_x2 = hp_y1;
out   = hp_y2;

lp_y1 = lp_a * out   + (1 - lp_a) * lp_y1;
lp_y2 = lp_a * lp_y1 + (1 - lp_a) * lp_y2;
out   = lp_y2;

// MORE = limiter blend toward the ceiling.
amt = more/100;
amt > 0 ? (
  ax  = abs(out);
  tgt = ax > ceiling ? ceiling/ax : 1;
  ac  = exp(-1/(0.0005*sr));
  rl  = exp(-1/(0.05*sr));
  lim_env = tgt < lim_env ? tgt + (lim_env-tgt)*ac : tgt + (lim_env-tgt)*rl;
  out = out*(1-amt) + (out*lim_env)*amt;
);

out = max(min(out, ceiling), -ceiling);
spl0 = out; spl1 = out;

@gfx 320 280
gfx_set(0,0,0,1); gfx_rect(0,0,gfx_w,gfx_h);
gfx_set(1,1,1,1);
gfx_rect(2,2,gfx_w-4,3);
gfx_rect(2,gfx_h-5,gfx_w-4,3);
gfx_rect(2,2,3,gfx_h-4);
gfx_rect(gfx_w-5,2,3,gfx_h-4);

gfx_setfont(1,"Arial",16,'b');
gfx_x=40; gfx_y=14; gfx_drawstr("INFLUENCE DAPPER DEEP");
gfx_x=80; gfx_y=36; gfx_drawstr("BIBLE THUMPER");

gfx_set(thump_on?1:0.25, 0, 0, 1); gfx_rect(40, 80, 100, 60);
gfx_set(1,1,1,1); gfx_x=66; gfx_y=104; gfx_drawstr("THUMP");

gfx_set(rump_on?1:0.25, 0, 0, 1); gfx_rect(180, 80, 100, 60);
gfx_set(1,1,1,1); gfx_x=212; gfx_y=104; gfx_drawstr("RUMP");

gfx_x=40; gfx_y=170; gfx_drawstr("MORE");
gfx_set(1,1,1,1); gfx_rect(40,210,240,4);
gfx_set(1,0,0,1);
sx = 40 + (more/100)*240;
gfx_rect(sx-5,200,10,24);

mouse_cap & 1 ? (
  !click_held && mouse_x>=40 && mouse_x<=140 && mouse_y>=80 && mouse_y<=140 ? (
    thump_on = 1 - thump_on; click_held = 1; slider_automate(slider1);
  );
  !click_held && mouse_x>=180 && mouse_x<=280 && mouse_y>=80 && mouse_y<=140 ? (
    rump_on = 1 - rump_on; click_held = 1; slider_automate(slider2);
  );
  mouse_y>=195 && mouse_y<=230 ? (
    nm = max(0,min(100,(mouse_x-40)/240*100));
    more = nm; slider_automate(slider3);
  );
) : ( click_held = 0; );
